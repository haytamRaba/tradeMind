# Environment variables. Copy to `.env` and edit.

# ---- Application ----

APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# ---- PostgreSQL ----
# Docker Compose injects DB_HOST=db and DB_PORT=5432 into application containers.
# DB_HOST=db
# DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=change-me
DB_NAME=trademind
# Optional full URL override. When unset, the fields above build the URL.
# DATABASE_URL=postgresql+psycopg2://trademind:change-me@localhost:5432/trademind

# ---- Market data ----
# Yahoo Finance access through yfinance does not require a project API key.

# ---- Research agent ----
# Optional. Without a key, the agent uses deterministic explanations.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol

# ---- Paper trading (simulated only) ----
PAPER_INITIAL_CASH=100000
MAX_RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_EXPOSURE_PCT=0.50
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=10

# ---- Logging ----
LOG_LEVEL=INFO
