# TradeMind Environment Configuration
# Copy this file to .env and fill in your values
# Process: Docker Compose, uvicorn, and pydantic-settings read this file
# Effect: Provides template for environment variables; no actual secrets committed
# No secrets are written in plain text - only placeholder values shown
# User instruction: complete all phases in plan.md (secrets management)

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=TradeMind
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=change-me-in-production
DB_NAME=trademind
# Or use full DATABASE_URL override:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Rate Limiting
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_MARKET_DATA=30
RATE_LIMIT_AGENTS=10

# Security
# Generate a strong secret key for production: openssl rand -hex 32
SECRET_KEY=your-secret-key-min-32-chars
# API Key for agent endpoints (optional)
API_KEY=your-api-key-here

# External APIs
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-6.2-sol

# Paper Trading Settings
PAPER_INITIAL_CASH=100000
MAX_RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT=0.10
MAX_PORTFOLIO_EXPOSURE_PCT=0.50
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=10

# Frontend (Streamlit)
FASTAPI_BASE_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501